{
  "id": "backbonecompare",
  "title": "Backbone Compare",
  "description": "Compare observed BGP neighbours and listed network exchanges and facilities for any two ASNs.",
  "category": "liminal-tools",
  "tags": [
    "networks",
    "asn",
    "bgp",
    "peering",
    "internet"
  ],
  "icon": "network",
  "url": "/backbonecompare/",
  "source": "https://github.com/jsdyer/backbonecompare",
  "hosting": "project",
  "access": "browser",
  "data_info": {
    "mode": "mixed",
    "detail": "RIPE RIS path observations and PeeringDB exchange/facility listings, with dated captures and public ASN lookups.",
    "cadence": "Daily",
    "probes": [
      {
        "url": "https://coolcode.ca/backbonecompare/data/status.json",
        "path": [
          "checked_at"
        ],
        "precision": "minute",
        "label": "Network sources checked",
        "count_at": {
          "path": [
            "count"
          ],
          "unit": "networks"
        }
      }
    ]
  }
}
